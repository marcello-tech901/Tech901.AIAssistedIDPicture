{
  "Azure": {
    "Speech": {
      "Key": "",
      "Region": "eastus",
      "MicrophoneDeviceId": "",
      "SpeakerDeviceId": ""
    },
    "Face": {
      "Key": "",
      "Endpoint": ""
    }
  },
  "Kiosk": {
    "AdminPin": "9019",
    "OutputDirectory": "./output",
    "OutputFormat": "jpg",
    "OutputWidth": 600,
    "OutputHeight": 600,
    "CropPaddingMultiplier": 1.6,
    "FilenameTemplate": "{StudentId}_{LastName}_{FirstName}",
    "SpeechVoice": "en-US-GuyNeural",
    "FaceDetectionIntervalMs": 1000,
    "IdleReturnDelaySeconds": 5,
    "CountdownSeconds": 3,
    "Camera": {
      "Width": 1920,
      "Height": 1080,
      "JpegQuality": 95
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Tech901": "Debug"
      }
    },
    "Enrich": [ "FromLogContext", "WithThreadId" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] ({SourceContext}) {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/idphoto-.log",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{ThreadId}] ({SourceContext}) {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
