<Application x:Class="Tech901.IdPhoto.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Tech901.IdPhoto.App.Views"
             xmlns:vm="clr-namespace:Tech901.IdPhoto.ViewModels;assembly=Tech901.IdPhoto.ViewModels">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/Tech901Theme.xaml" />
        <ResourceDictionary Source="Themes/Controls.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- ViewModel-to-View DataTemplate mappings -->
      <DataTemplate DataType="{x:Type vm:IdleViewModel}">
        <views:IdleView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:NameCaptureViewModel}">
        <views:NameCaptureView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:RosterMatchViewModel}">
        <views:RosterMatchView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:PositioningViewModel}">
        <views:PositioningView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:CaptureViewModel}">
        <views:CaptureView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:ReviewViewModel}">
        <views:ReviewView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:CompleteViewModel}">
        <views:CompleteView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:AdminViewModel}">
        <views:AdminView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:BatchProcessViewModel}">
        <views:BatchProcessView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:ErrorViewModel}">
        <views:ErrorView />
      </DataTemplate>
    </ResourceDictionary>
  </Application.Resources>
</Application>
