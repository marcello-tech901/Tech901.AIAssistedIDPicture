<UserControl x:Class="Tech901.IdPhoto.App.Views.NameCaptureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Tech901.IdPhoto.App.Converters">
  <UserControl.Resources>
    <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <converters:SpeechStateToVisibilityConverter x:Key="SpeechStateToVisibility" />

    <!-- Microphone icon path data -->
    <Geometry x:Key="MicrophoneGeometry">M12,2C10.34,2 9,3.34 9,5V11C9,12.66 10.34,14 12,14C13.66,14 15,12.66 15,11V5C15,3.34 13.66,2 12,2M19,11C19,14.53 16.39,17.44 13,17.93V21H11V17.93C7.61,17.44 5,14.53 5,11H7C7,13.76 9.24,16 12,16C14.76,16 17,13.76 17,11H19Z</Geometry>

    <!-- Checkmark icon path data -->
    <Geometry x:Key="CheckmarkGeometry">M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z</Geometry>
  </UserControl.Resources>

  <Grid>
    <Border Background="{StaticResource OverlayBrush}" />

    <!-- Glass card container -->
    <Border Style="{StaticResource GlassCardStyle}"
            MaxWidth="640"
            VerticalAlignment="Center"
            HorizontalAlignment="Center">
      <Border.RenderTransform>
        <TranslateTransform />
      </Border.RenderTransform>
      <Border.Triggers>
        <EventTrigger RoutedEvent="Loaded">
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetProperty="Opacity"
                               From="0" To="1" Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction>
                  <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
              </DoubleAnimation>
              <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                               From="24" To="0" Duration="0:0:0.6">
                <DoubleAnimation.EasingFunction>
                  <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
              </DoubleAnimation>
            </Storyboard>
          </BeginStoryboard>
        </EventTrigger>
      </Border.Triggers>

      <StackPanel>
        <TextBlock Text="What's your name?"
                   Style="{StaticResource HeadingTextStyle}"
                   Margin="0,0,0,36" />

        <!-- ══════════ READY state — dim mic, waiting ══════════ -->
        <StackPanel Visibility="{Binding SpeechState, Converter={StaticResource SpeechStateToVisibility}, ConverterParameter=Ready}"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,20">
          <StackPanel.RenderTransform>
            <TranslateTransform />
          </StackPanel.RenderTransform>
          <StackPanel.Triggers>
            <EventTrigger RoutedEvent="Loaded">
              <BeginStoryboard>
                <Storyboard>
                  <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                   From="0" To="1" Duration="0:0:0.4">
                    <DoubleAnimation.EasingFunction>
                      <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                  </DoubleAnimation>
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
          </StackPanel.Triggers>

          <Grid Width="80" Height="80" HorizontalAlignment="Center">
            <!-- Static dim ring -->
            <Ellipse Width="80" Height="80"
                     Stroke="{StaticResource LimeDimBrush}"
                     StrokeThickness="2"
                     Opacity="0.3" />
            <!-- Mic icon -->
            <Viewbox Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Path Data="{StaticResource MicrophoneGeometry}"
                    Fill="{StaticResource LimeDimBrush}"
                    Opacity="0.5" />
            </Viewbox>
          </Grid>

          <TextBlock Text="{Binding StatusText}"
                     Style="{StaticResource CaptionTextStyle}"
                     HorizontalAlignment="Center"
                     Margin="0,12,0,0" />
        </StackPanel>

        <!-- ══════════ LISTENING state — pulsing rings + mic ══════════ -->
        <StackPanel Visibility="{Binding SpeechState, Converter={StaticResource SpeechStateToVisibility}, ConverterParameter=Listening}"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,20">
          <Grid Width="100" Height="100" HorizontalAlignment="Center">
            <!-- Outer pulse ring 3 -->
            <Ellipse Width="100" Height="100"
                     Stroke="{StaticResource LimeGreenBrush}"
                     StrokeThickness="1.5"
                     Opacity="0.1">
              <Ellipse.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                  <BeginStoryboard>
                    <Storyboard RepeatBehavior="Forever">
                      <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                       From="0.05" To="0.25"
                                       Duration="0:0:1.2"
                                       AutoReverse="True">
                        <DoubleAnimation.EasingFunction>
                          <SineEase EasingMode="EaseInOut" />
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </EventTrigger>
              </Ellipse.Triggers>
            </Ellipse>
            <!-- Middle pulse ring 2 -->
            <Ellipse Width="72" Height="72"
                     Stroke="{StaticResource LimeGreenBrush}"
                     StrokeThickness="2"
                     Opacity="0.2"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center">
              <Ellipse.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                  <BeginStoryboard>
                    <Storyboard RepeatBehavior="Forever">
                      <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                       From="0.1" To="0.4"
                                       Duration="0:0:0.9"
                                       AutoReverse="True">
                        <DoubleAnimation.EasingFunction>
                          <SineEase EasingMode="EaseInOut" />
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </EventTrigger>
              </Ellipse.Triggers>
            </Ellipse>
            <!-- Inner solid mic circle -->
            <Ellipse Width="48" Height="48"
                     Fill="{StaticResource LimeGreenBrush}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center">
              <Ellipse.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                  <BeginStoryboard>
                    <Storyboard RepeatBehavior="Forever">
                      <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                       From="0.5" To="1.0"
                                       Duration="0:0:0.6"
                                       AutoReverse="True">
                        <DoubleAnimation.EasingFunction>
                          <SineEase EasingMode="EaseInOut" />
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </EventTrigger>
              </Ellipse.Triggers>
              <Ellipse.Effect>
                <DropShadowEffect Color="#A4CC27" BlurRadius="24" ShadowDepth="0" Opacity="0.6" />
              </Ellipse.Effect>
            </Ellipse>
            <!-- Mic icon -->
            <Viewbox Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Path Data="{StaticResource MicrophoneGeometry}"
                    Fill="{StaticResource NearBlackBrush}" />
            </Viewbox>
          </Grid>

          <TextBlock Text="{Binding StatusText}"
                     Style="{StaticResource CaptionTextStyle}"
                     Foreground="{StaticResource LimeGreenBrush}"
                     HorizontalAlignment="Center"
                     Margin="0,12,0,0" />
        </StackPanel>

        <!-- ══════════ RECOGNIZED state — checkmark + name ══════════ -->
        <StackPanel Visibility="{Binding SpeechState, Converter={StaticResource SpeechStateToVisibility}, ConverterParameter=Recognized}"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,20">
          <StackPanel.RenderTransform>
            <TranslateTransform />
          </StackPanel.RenderTransform>
          <StackPanel.Triggers>
            <EventTrigger RoutedEvent="Loaded">
              <BeginStoryboard>
                <Storyboard>
                  <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                   From="0" To="1" Duration="0:0:0.4">
                    <DoubleAnimation.EasingFunction>
                      <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                  </DoubleAnimation>
                  <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                   From="12" To="0" Duration="0:0:0.5">
                    <DoubleAnimation.EasingFunction>
                      <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                  </DoubleAnimation>
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
          </StackPanel.Triggers>

          <Grid Width="64" Height="64" HorizontalAlignment="Center">
            <Ellipse Width="64" Height="64"
                     Fill="{StaticResource LimeGreenBrush}"
                     Opacity="0.15" />
            <Ellipse Width="64" Height="64"
                     Stroke="{StaticResource LimeGreenBrush}"
                     StrokeThickness="2" />
            <Viewbox Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Path Data="{StaticResource CheckmarkGeometry}"
                    Fill="{StaticResource LimeGreenBrush}" />
            </Viewbox>
          </Grid>

          <TextBlock Text="{Binding RecognizedText}"
                     Style="{StaticResource HeadingTextStyle}"
                     Foreground="{StaticResource LimeGreenBrush}"
                     Margin="0,16,0,0">
            <TextBlock.Effect>
              <DropShadowEffect Color="#A4CC27" BlurRadius="16" ShadowDepth="0" Opacity="0.3" />
            </TextBlock.Effect>
          </TextBlock>

          <TextBlock Text="{Binding StatusText}"
                     Style="{StaticResource CaptionTextStyle}"
                     HorizontalAlignment="Center"
                     Margin="0,4,0,0" />
        </StackPanel>

        <!-- ══════════ FAILED state — dim mic + gold warning ══════════ -->
        <StackPanel Visibility="{Binding SpeechState, Converter={StaticResource SpeechStateToVisibility}, ConverterParameter=Failed}"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,20">
          <StackPanel.RenderTransform>
            <TranslateTransform />
          </StackPanel.RenderTransform>
          <StackPanel.Triggers>
            <EventTrigger RoutedEvent="Loaded">
              <BeginStoryboard>
                <Storyboard>
                  <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                   From="0" To="1" Duration="0:0:0.4">
                    <DoubleAnimation.EasingFunction>
                      <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                  </DoubleAnimation>
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
          </StackPanel.Triggers>

          <Grid Width="64" Height="64" HorizontalAlignment="Center">
            <Ellipse Width="64" Height="64"
                     Stroke="{StaticResource GoldDimBrush}"
                     StrokeThickness="2"
                     Opacity="0.5" />
            <Viewbox Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Path Data="{StaticResource MicrophoneGeometry}"
                    Fill="{StaticResource GoldDimBrush}"
                    Opacity="0.6" />
            </Viewbox>
          </Grid>

          <TextBlock Text="{Binding StatusText}"
                     Style="{StaticResource CaptionTextStyle}"
                     Foreground="{StaticResource GoldBrush}"
                     HorizontalAlignment="Center"
                     Margin="0,12,0,0" />
        </StackPanel>

        <!-- ══════════ OR TYPE divider + TextBox (always visible as fallback) ══════════ -->
        <TextBlock Text="OR TYPE YOUR NAME"
                   Style="{StaticResource LabelTextStyle}"
                   Margin="0,0,0,8" />

        <TextBox Text="{Binding TypedName, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource KioskTextBoxStyle}"
                 Margin="0,0,0,32" />

        <!-- ══════════ Buttons ══════════ -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <Button Content="Continue"
                  Style="{StaticResource PrimaryButtonStyle}"
                  Command="{Binding SubmitCommand}"
                  Margin="0,0,16,0" />

          <!-- Try Again — visible in Failed or Recognized states -->
          <Button Content="Try Again"
                  Style="{StaticResource SecondaryButtonStyle}"
                  Command="{Binding ListenCommand}">
            <Button.Visibility>
              <Binding Path="SpeechState"
                       Converter="{StaticResource SpeechStateToVisibility}"
                       ConverterParameter="Failed,Recognized" />
            </Button.Visibility>
          </Button>
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
