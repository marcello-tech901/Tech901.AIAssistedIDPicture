<UserControl x:Class="Tech901.IdPhoto.App.Views.AdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Tech901.IdPhoto.App.Converters">
  <UserControl.Resources>
    <converters:NotNullToVisibilityConverter x:Key="NotNullToVisibilityConverter" />
    <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    <converters:ByteArrayToImageConverter x:Key="ByteArrayToImageConverter" />
    <converters:BoolToVisibilityConverter x:Key="BoolToVisInvertConverter" />
  </UserControl.Resources>
  <Grid Background="{StaticResource BackgroundGradientBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Header bar — navy gradient with glass edge -->
    <Border Grid.Row="0" Padding="32,18">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.5">
          <GradientStop Color="#002244" Offset="0" />
          <GradientStop Color="#003763" Offset="0.6" />
          <GradientStop Color="#002A50" Offset="1" />
        </LinearGradientBrush>
      </Border.Background>
      <Border.BorderBrush>
        <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
          <GradientStop Color="#20FFFFFF" Offset="0" />
          <GradientStop Color="#00FFFFFF" Offset="1" />
        </LinearGradientBrush>
      </Border.BorderBrush>
      <Border.BorderThickness>0,0,0,1</Border.BorderThickness>
      <DockPanel>
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="&#x2699;" FontSize="20" Foreground="{StaticResource WhiteDimBrush}" Margin="0,0,12,0" VerticalAlignment="Center" />
          <TextBlock Text="Admin Panel"
                     Style="{StaticResource HeadingTextStyle}"
                     TextAlignment="Left"
                     FontSize="26" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button Command="{Binding ToggleServiceStatusCommand}"
                  Padding="10,6"
                  FontSize="12"
                  Margin="0,0,12,0"
                  ToolTip="Toggle Azure service status panel">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                <Setter Property="Foreground" Value="{StaticResource WhiteDimBrush}" />
                <Setter Property="Content" Value="Azure Services" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsServiceStatusVisible}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource LimeGreenBrush}" />
                    <Setter Property="Content" Value="Azure Services" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
          <Button Content="Back to Kiosk"
                  Style="{StaticResource GhostButtonStyle}"
                  Foreground="{StaticResource WhiteBrush}"
                  Command="{Binding ExitAdminCommand}"
                  VerticalAlignment="Center" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1" Margin="32,24,32,32">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="440" />
        <ColumnDefinition Width="24" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Left panel: Controls in glass card -->
      <Border Grid.Column="0"
              Style="{StaticResource GlassCardStyle}"
              Padding="28,24">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <!-- ═══════════════ AZURE SERVICES STATUS ═══════════════ -->
            <Border Visibility="{Binding IsServiceStatusVisible, Converter={StaticResource BoolToVisConverter}}"
                    Margin="0,0,0,20">
              <Border CornerRadius="10"
                      Padding="20,18">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#14003763" Offset="0" />
                    <GradientStop Color="#0C1A1A26" Offset="1" />
                  </LinearGradientBrush>
                </Border.Background>
                <Border.BorderBrush>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#30003763" Offset="0" />
                    <GradientStop Color="#18003763" Offset="1" />
                  </LinearGradientBrush>
                </Border.BorderBrush>
                <Border.BorderThickness>1</Border.BorderThickness>
                <StackPanel>
                  <!-- Section header -->
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="AZURE AI SERVICES"
                               Style="{StaticResource LabelTextStyle}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="AI-102"
                               FontSize="9"
                               FontWeight="Bold"
                               Foreground="{StaticResource NavyBrush}"
                               Background="#20003763"
                               Padding="6,2"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                  </StackPanel>
                  <TextBlock Text="Null Object Pattern — services degrade gracefully when Azure credentials are absent."
                             Style="{StaticResource CaptionTextStyle}"
                             Foreground="{StaticResource SecondaryTextBrush}"
                             FontSize="10"
                             FontStyle="Italic"
                             TextWrapping="Wrap"
                             Margin="0,0,0,14" />

                  <!-- ── Speech Service ── -->
                  <Border CornerRadius="8"
                          Background="{StaticResource SurfaceBrush}"
                          Padding="14,12"
                          Margin="0,0,0,8">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>

                      <!-- Status indicator dot -->
                      <Ellipse Grid.Column="0" Grid.RowSpan="2"
                               Width="10" Height="10"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0">
                        <Ellipse.Style>
                          <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{StaticResource ErrorRedBrush}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsSpeechAvailable}" Value="True">
                                <Setter Property="Fill" Value="{StaticResource LimeGreenBrush}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Ellipse.Style>
                      </Ellipse>

                      <!-- Service name -->
                      <TextBlock Grid.Column="1" Grid.Row="0"
                                 Text="Speech Service"
                                 Style="{StaticResource CaptionTextStyle}"
                                 Foreground="{StaticResource WhiteBrush}"
                                 FontWeight="SemiBold"
                                 FontSize="13" />

                      <!-- Status badge -->
                      <Border Grid.Column="2" Grid.Row="0"
                              CornerRadius="4"
                              Padding="8,2"
                              VerticalAlignment="Center">
                        <Border.Style>
                          <Style TargetType="Border">
                            <Setter Property="Background" Value="#25FF4466" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsSpeechAvailable}" Value="True">
                                <Setter Property="Background" Value="#20A4CC27" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <TextBlock FontSize="10" FontWeight="SemiBold">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Text" Value="FALLBACK" />
                              <Setter Property="Foreground" Value="{StaticResource ErrorRedBrush}" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSpeechAvailable}" Value="True">
                                  <Setter Property="Text" Value="ACTIVE" />
                                  <Setter Property="Foreground" Value="{StaticResource LimeGreenBrush}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </Border>

                      <!-- Description -->
                      <TextBlock Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1"
                                 Text="{Binding SpeechFallbackDescription}"
                                 Style="{StaticResource CaptionTextStyle}"
                                 FontSize="10"
                                 TextWrapping="Wrap"
                                 Margin="0,3,0,0" />
                    </Grid>
                  </Border>

                  <!-- ── Face API ── -->
                  <Border CornerRadius="8"
                          Background="{StaticResource SurfaceBrush}"
                          Padding="14,12"
                          Margin="0,0,0,8">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>

                      <Ellipse Grid.Column="0" Grid.RowSpan="2"
                               Width="10" Height="10"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0">
                        <Ellipse.Style>
                          <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{StaticResource ErrorRedBrush}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsFaceDetectionAvailable}" Value="True">
                                <Setter Property="Fill" Value="{StaticResource LimeGreenBrush}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Ellipse.Style>
                      </Ellipse>

                      <TextBlock Grid.Column="1" Grid.Row="0"
                                 Text="Face API"
                                 Style="{StaticResource CaptionTextStyle}"
                                 Foreground="{StaticResource WhiteBrush}"
                                 FontWeight="SemiBold"
                                 FontSize="13" />

                      <Border Grid.Column="2" Grid.Row="0"
                              CornerRadius="4"
                              Padding="8,2"
                              VerticalAlignment="Center">
                        <Border.Style>
                          <Style TargetType="Border">
                            <Setter Property="Background" Value="#25FF4466" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsFaceDetectionAvailable}" Value="True">
                                <Setter Property="Background" Value="#20A4CC27" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <TextBlock FontSize="10" FontWeight="SemiBold">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Text" Value="FALLBACK" />
                              <Setter Property="Foreground" Value="{StaticResource ErrorRedBrush}" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFaceDetectionAvailable}" Value="True">
                                  <Setter Property="Text" Value="ACTIVE" />
                                  <Setter Property="Foreground" Value="{StaticResource LimeGreenBrush}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </Border>

                      <TextBlock Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1"
                                 Text="{Binding FaceDetectionFallbackDescription}"
                                 Style="{StaticResource CaptionTextStyle}"
                                 FontSize="10"
                                 TextWrapping="Wrap"
                                 Margin="0,3,0,0" />
                    </Grid>
                  </Border>

                  <!-- ── Presence Detection (always local) ── -->
                  <Border CornerRadius="8"
                          Background="{StaticResource SurfaceBrush}"
                          Padding="14,12">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>

                      <Ellipse Grid.Column="0" Grid.RowSpan="2"
                               Width="10" Height="10"
                               Fill="{StaticResource LimeGreenBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />

                      <TextBlock Grid.Column="1" Grid.Row="0"
                                 Text="Presence Detection"
                                 Style="{StaticResource CaptionTextStyle}"
                                 Foreground="{StaticResource WhiteBrush}"
                                 FontWeight="SemiBold"
                                 FontSize="13" />

                      <Border Grid.Column="2" Grid.Row="0"
                              CornerRadius="4"
                              Padding="8,2"
                              Background="#20003763"
                              VerticalAlignment="Center">
                        <TextBlock Text="LOCAL"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource NavyBrush}" />
                      </Border>

                      <TextBlock Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1"
                                 Text="{Binding PresenceDetectionDescription}"
                                 Style="{StaticResource CaptionTextStyle}"
                                 FontSize="10"
                                 TextWrapping="Wrap"
                                 Margin="0,3,0,0" />
                    </Grid>
                  </Border>
                </StackPanel>
              </Border>

              <!-- Section divider after service status -->
            </Border>

            <!-- ═══════════════ ROSTER SECTION ═══════════════ -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <TextBlock Text="&#x1F4CB;" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBlock Text="ROSTER"
                         Style="{StaticResource LabelTextStyle}" />
            </StackPanel>

            <Button Content="Import CSV Roster"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding ImportRosterCommand}"
                    HorizontalAlignment="Stretch"
                    MinWidth="0"
                    Margin="0,0,0,6" />
            <TextBlock Text="Load a CSV file containing participant names and IDs. Expected columns: StudentId, FirstName, LastName."
                       Style="{StaticResource CaptionTextStyle}"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       TextWrapping="Wrap"
                       FontSize="11"
                       Margin="0,0,0,10" />

            <TextBlock Text="{Binding RosterFilePath}"
                       Style="{StaticResource CaptionTextStyle}"
                       FontFamily="{StaticResource MonoFont}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12" />

            <!-- IMPORT RESULT PANEL -->
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14,12"
                    Margin="0,0,0,16"
                    Visibility="{Binding IsImportResultVisible, Converter={StaticResource BoolToVisConverter}}">
              <StackPanel>
                <!-- Error state -->
                <StackPanel Visibility="{Binding ImportErrorMessage, Converter={StaticResource NotNullToVisibilityConverter}}">
                  <TextBlock Text="IMPORT FAILED"
                             Style="{StaticResource LabelTextStyle}"
                             Foreground="{StaticResource ErrorRedBrush}"
                             Margin="0,0,0,6" />
                  <TextBlock Text="{Binding ImportErrorMessage}"
                             Style="{StaticResource CaptionTextStyle}"
                             Foreground="{StaticResource ErrorRedBrush}"
                             TextWrapping="Wrap"
                             Margin="0,0,0,8" />
                </StackPanel>

                <!-- Success/result state -->
                <StackPanel Visibility="{Binding LastImportResult, Converter={StaticResource NotNullToVisibilityConverter}}">
                  <!-- Summary line -->
                  <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,6">
                    <Run Text="{Binding LastImportResult.ImportedCount, Mode=OneWay}" Foreground="{StaticResource LimeGreenBrush}" />
                    <Run Text=" imported, " Foreground="{StaticResource SecondaryTextBrush}" />
                    <Run Text="{Binding LastImportResult.SkippedCount, Mode=OneWay}" Foreground="{StaticResource SecondaryTextBrush}" />
                    <Run Text=" skipped" Foreground="{StaticResource SecondaryTextBrush}" />
                  </TextBlock>

                  <!-- Errors list -->
                  <ItemsControl ItemsSource="{Binding LastImportResult.Errors}" Margin="0,0,0,4">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Style="{StaticResource CaptionTextStyle}"
                                   Foreground="{StaticResource ErrorRedBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,1">
                          <Run Text="Row " /><Run Text="{Binding RowNumber, Mode=OneWay}" /><Run Text=": " /><Run Text="{Binding Message, Mode=OneWay}" />
                        </TextBlock>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <!-- Warnings list -->
                  <ItemsControl ItemsSource="{Binding LastImportResult.Warnings}" Margin="0,0,0,4">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Style="{StaticResource CaptionTextStyle}"
                                   Foreground="{StaticResource GoldBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,1">
                          <Run Text="Row " /><Run Text="{Binding RowNumber, Mode=OneWay}" /><Run Text=": " /><Run Text="{Binding Message, Mode=OneWay}" />
                        </TextBlock>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <!-- Duration -->
                  <TextBlock Style="{StaticResource CaptionTextStyle}"
                             Foreground="{StaticResource SecondaryTextBrush}"
                             Margin="0,2,0,6">
                    <Run Text="Completed in " /><Run Text="{Binding LastImportResult.Duration.TotalMilliseconds, Mode=OneWay, StringFormat={}{0:F0}ms}" />
                  </TextBlock>
                </StackPanel>

                <!-- Dismiss button -->
                <Button Content="Dismiss"
                        Style="{StaticResource GhostButtonStyle}"
                        Command="{Binding DismissImportResultCommand}"
                        HorizontalAlignment="Left"
                        Padding="8,4"
                        FontSize="12" />
              </StackPanel>
            </Border>

            <!-- Section divider -->
            <Border Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="0,4,0,4" />

            <!-- ═══════════════ OUTPUT SECTION ═══════════════ -->
            <StackPanel Orientation="Horizontal" Margin="0,28,0,8">
              <TextBlock Text="&#x1F4C1;" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBlock Text="OUTPUT SETTINGS"
                         Style="{StaticResource LabelTextStyle}" />
            </StackPanel>

            <TextBlock Text="Output Directory" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,6" />
            <Grid Margin="0,0,0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox Grid.Column="0"
                       Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}"
                       Style="{StaticResource KioskTextBoxStyle}"
                       FontSize="14"
                       Padding="14,10" />
              <Button Grid.Column="1"
                      Content="Browse..."
                      Style="{StaticResource GhostButtonStyle}"
                      Command="{Binding BrowseOutputFolderCommand}"
                      Padding="14,10"
                      FontSize="13"
                      Margin="8,0,0,0"
                      VerticalAlignment="Stretch" />
            </Grid>
            <TextBlock Text="Folder where captured ID photos will be saved. Click Browse to select."
                       Style="{StaticResource CaptionTextStyle}"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       TextWrapping="Wrap"
                       FontSize="11"
                       Margin="0,0,0,14" />

            <TextBlock Text="Filename Template" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,6" />
            <TextBox Text="{Binding FilenameTemplate, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource KioskTextBoxStyle}"
                     FontSize="14"
                     FontFamily="{StaticResource MonoFont}"
                     Padding="14,10"
                     Margin="0,0,0,4" />
            <TextBlock Text="Pattern for photo filenames. Available tokens:"
                       Style="{StaticResource CaptionTextStyle}"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       FontSize="11"
                       Margin="0,0,0,6" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
              <Button Content="{}{StudentId}"
                      Style="{StaticResource GhostButtonStyle}"
                      Command="{Binding InsertTokenCommand}"
                      CommandParameter="{}{StudentId}"
                      Padding="8,4"
                      FontSize="11"
                      FontFamily="{StaticResource MonoFont}"
                      Margin="0,0,6,0" />
              <Button Content="{}{FirstName}"
                      Style="{StaticResource GhostButtonStyle}"
                      Command="{Binding InsertTokenCommand}"
                      CommandParameter="{}{FirstName}"
                      Padding="8,4"
                      FontSize="11"
                      FontFamily="{StaticResource MonoFont}"
                      Margin="0,0,6,0" />
              <Button Content="{}{LastName}"
                      Style="{StaticResource GhostButtonStyle}"
                      Command="{Binding InsertTokenCommand}"
                      CommandParameter="{}{LastName}"
                      Padding="8,4"
                      FontSize="11"
                      FontFamily="{StaticResource MonoFont}" />
            </StackPanel>

            <TextBlock Text="Output Format" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,6" />
            <ComboBox SelectedItem="{Binding OutputFormat}"
                      Style="{StaticResource KioskComboBoxStyle}"
                      Margin="0,0,0,4">
              <ComboBoxItem Content="jpg" />
              <ComboBoxItem Content="png" />
            </ComboBox>
            <TextBlock Text="Image format for saved photos. JPG is smaller, PNG is lossless."
                       Style="{StaticResource CaptionTextStyle}"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       TextWrapping="Wrap"
                       FontSize="11"
                       Margin="0,0,0,32" />

            <!-- Section divider -->
            <Border Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="0,4,0,4" />

            <!-- ═══════════════ CAMERA SECTION ═══════════════ -->
            <StackPanel Orientation="Horizontal" Margin="0,28,0,8">
              <TextBlock Text="&#x1F4F7;" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBlock Text="CAMERA"
                         Style="{StaticResource LabelTextStyle}" />
            </StackPanel>

            <TextBlock Text="Camera Device" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,6" />
            <ComboBox ItemsSource="{Binding CameraDevices}"
                      SelectedItem="{Binding SelectedCameraDevice}"
                      DisplayMemberPath="DisplayName"
                      Style="{StaticResource KioskComboBoxStyle}"
                      Margin="0,0,0,4" />
            <TextBlock Text="Select which camera to use for ID photo capture. If you have multiple cameras (built-in + USB), choose the preferred one."
                       Style="{StaticResource CaptionTextStyle}"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       TextWrapping="Wrap"
                       FontSize="11"
                       Margin="0,0,0,10" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
              <Button Content="Refresh Cameras"
                      Style="{StaticResource GhostButtonStyle}"
                      Command="{Binding RefreshCameraDevicesCommand}"
                      Padding="10,6"
                      FontSize="12"
                      Margin="0,0,8,0" />
              <Button Command="{Binding ToggleCameraPreviewCommand}"
                      Padding="10,6"
                      FontSize="12">
                <Button.Style>
                  <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                    <Setter Property="Content" Value="Show Preview" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsCameraPreviewActive}" Value="True">
                        <Setter Property="Content" Value="Hide Preview" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
              </Button>
            </StackPanel>

            <!-- Live camera preview -->
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="4"
                    Margin="0,0,0,10"
                    MaxHeight="200"
                    Visibility="{Binding IsCameraPreviewActive, Converter={StaticResource BoolToVisConverter}}">
              <Image Source="{Binding CameraPreviewFrame, Converter={StaticResource ByteArrayToImageConverter}}"
                     Stretch="Uniform"
                     RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                  <ScaleTransform ScaleX="-1" />
                </Image.RenderTransform>
              </Image>
            </Border>

            <!-- Switching indicator -->
            <TextBlock Text="Switching camera..."
                       Style="{StaticResource CaptionTextStyle}"
                       Foreground="{StaticResource GoldBrush}"
                       Margin="0,0,0,10"
                       Visibility="{Binding IsCameraSwitching, Converter={StaticResource BoolToVisConverter}}" />

            <Border Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="0,4,0,4" />

            <!-- ═══════════════ AUDIO DEVICES SECTION ═══════════════ -->
            <StackPanel Orientation="Horizontal" Margin="0,28,0,8">
              <TextBlock Text="&#x1F50A;" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBlock Text="AUDIO DEVICES"
                         Style="{StaticResource LabelTextStyle}" />
            </StackPanel>

            <TextBlock Text="Microphone" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,6" />
            <ComboBox ItemsSource="{Binding MicrophoneDevices}"
                      SelectedItem="{Binding SelectedMicrophoneDevice}"
                      DisplayMemberPath="DisplayName"
                      Style="{StaticResource KioskComboBoxStyle}"
                      Margin="0,0,0,4" />
            <TextBlock Text="Input device for voice commands. Select your USB or built-in microphone."
                       Style="{StaticResource CaptionTextStyle}"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       TextWrapping="Wrap"
                       FontSize="11"
                       Margin="0,0,0,14" />

            <TextBlock Text="Speaker" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,6" />
            <ComboBox ItemsSource="{Binding SpeakerDevices}"
                      SelectedItem="{Binding SelectedSpeakerDevice}"
                      DisplayMemberPath="DisplayName"
                      Style="{StaticResource KioskComboBoxStyle}"
                      Margin="0,0,0,4" />
            <TextBlock Text="Output device for spoken prompts. Select your speaker or audio output."
                       Style="{StaticResource CaptionTextStyle}"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       TextWrapping="Wrap"
                       FontSize="11"
                       Margin="0,0,0,10" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,32">
              <Button Content="Refresh Devices"
                      Style="{StaticResource GhostButtonStyle}"
                      Command="{Binding RefreshDevicesCommand}"
                      Padding="10,6"
                      FontSize="12"
                      Margin="0,0,8,0" />
              <Button Content="Test Speaker"
                      Style="{StaticResource GhostButtonStyle}"
                      Command="{Binding TestSpeakerCommand}"
                      Padding="10,6"
                      FontSize="12" />
            </StackPanel>

            <!-- Section divider -->
            <Border Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="0,4,0,4" />

            <!-- ═══════════════ ACTIONS ═══════════════ -->
            <StackPanel Orientation="Horizontal" Margin="0,28,0,8">
              <TextBlock Text="&#x26A1;" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBlock Text="ACTIONS"
                         Style="{StaticResource LabelTextStyle}" />
            </StackPanel>

            <Button Content="Export Session Report"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding ExportReportCommand}"
                    HorizontalAlignment="Stretch"
                    MinWidth="0"
                    Margin="0,0,0,4" />
            <TextBlock Text="Save current session progress as a JSON file."
                       Style="{StaticResource CaptionTextStyle}"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       TextWrapping="Wrap"
                       FontSize="11"
                       Margin="0,0,0,14" />

            <Button Content="Batch Process Photos"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding OpenBatchCommand}"
                    HorizontalAlignment="Stretch"
                    MinWidth="0"
                    Margin="0,0,0,4" />
            <TextBlock Text="Crop and process multiple photos from a folder at once."
                       Style="{StaticResource CaptionTextStyle}"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       TextWrapping="Wrap"
                       FontSize="11" />
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- Right panel: Progress table in glass card -->
      <Border Grid.Column="2"
              Style="{StaticResource GlassCardStyle}"
              Padding="24,20">
        <DockPanel>
          <!-- Progress header with luminous count -->
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="STUDENT PROGRESS"
                       Style="{StaticResource LabelTextStyle}"
                       DockPanel.Dock="Left"
                       VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
              <TextBlock Style="{StaticResource HeadingTextStyle}" FontSize="22" TextAlignment="Right">
                <Run Text="{Binding CompletedCount, Mode=OneWay}" Foreground="{StaticResource LimeGreenBrush}" />
                <Run Text=" / " Foreground="{StaticResource SecondaryTextBrush}" />
                <Run Text="{Binding TotalCount, Mode=OneWay}" Foreground="{StaticResource SecondaryTextBrush}" />
              </TextBlock>
            </StackPanel>
          </DockPanel>

          <!-- Progress bar -->
          <ProgressBar DockPanel.Dock="Top"
                       Style="{StaticResource KioskProgressBarStyle}"
                       Value="{Binding CompletedCount}"
                       Maximum="{Binding TotalCount}"
                       Margin="0,0,0,16" />

          <!-- Data grid -->
          <DataGrid ItemsSource="{Binding Students}"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    Background="Transparent"
                    Foreground="{StaticResource WhiteBrush}"
                    FontFamily="{StaticResource PrimaryFont}"
                    FontSize="14"
                    BorderThickness="0"
                    GridLinesVisibility="Horizontal"
                    HorizontalGridLinesBrush="{StaticResource BorderSubtleBrush}"
                    RowBackground="Transparent"
                    AlternatingRowBackground="#08FFFFFF"
                    HeadersVisibility="Column">
            <DataGrid.ColumnHeaderStyle>
              <Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="8,10" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
              </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.CellStyle>
              <Style TargetType="DataGridCell">
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="8,8" />
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                      <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                        <ContentPresenter VerticalAlignment="Center" />
                      </Border>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </DataGrid.CellStyle>
            <DataGrid.Columns>
              <DataGridTextColumn Header="STUDENT ID" Binding="{Binding Student.StudentId}" Width="130" />
              <DataGridTextColumn Header="FIRST NAME" Binding="{Binding Student.FirstName}" Width="*" />
              <DataGridTextColumn Header="LAST NAME" Binding="{Binding Student.LastName}" Width="*" />
              <DataGridTemplateColumn Header="STATUS" Width="100">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border CornerRadius="4"
                            Padding="8,3"
                            HorizontalAlignment="Left">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Background" Value="#20666666" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                              <Setter Property="Background" Value="#20A4CC27" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <TextBlock FontSize="11" FontWeight="SemiBold">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="Pending" />
                            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                <Setter Property="Text" Value="Done" />
                                <Setter Property="Foreground" Value="{StaticResource LimeGreenBrush}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
