<UserControl x:Class="Tech901.IdPhoto.App.Views.ErrorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Border Background="{StaticResource OverlayBrush}" />

    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
      <!-- Error icon -->
      <Grid Width="130" Height="130" HorizontalAlignment="Center" Margin="0,0,0,36">
        <Ellipse Fill="#CC3333">
          <Ellipse.Effect>
            <DropShadowEffect Color="#CC3333" BlurRadius="50" ShadowDepth="0" Opacity="0.5" />
          </Ellipse.Effect>
        </Ellipse>
        <TextBlock Text="!"
                   FontSize="72"
                   FontWeight="Bold"
                   Foreground="White"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Margin="0,-4,0,0" />
      </Grid>

      <TextBlock Text="Something went wrong"
                 Style="{StaticResource DisplayTextStyle}"
                 Margin="0,0,0,12" />

      <TextBlock Text="{Binding ErrorMessage, Mode=OneWay}"
                 Style="{StaticResource SubheadingTextStyle}"
                 TextWrapping="Wrap"
                 MaxWidth="500"
                 HorizontalAlignment="Center"
                 Margin="0,0,0,24" />

      <Button Command="{Binding DismissCommand}"
              Content="Return to Start"
              Style="{StaticResource PrimaryButtonStyle}"
              HorizontalAlignment="Center" />
    </StackPanel>
  </Grid>
</UserControl>
