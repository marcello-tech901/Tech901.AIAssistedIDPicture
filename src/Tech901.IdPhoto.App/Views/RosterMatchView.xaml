<UserControl x:Class="Tech901.IdPhoto.App.Views.RosterMatchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Tech901.IdPhoto.App.Converters">
  <UserControl.Resources>
    <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
  </UserControl.Resources>

  <Grid>
    <Border Background="{StaticResource OverlayBrush}" />

    <Border Style="{StaticResource GlassCardStyle}"
            MaxWidth="620"
            VerticalAlignment="Center"
            HorizontalAlignment="Center">

      <StackPanel>
        <!-- Single match confirmation -->
        <StackPanel Visibility="{Binding IsSingleMatch, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Style="{StaticResource HeadingTextStyle}" Margin="0,0,0,8">
            <Run Text="Is this you?" />
          </TextBlock>

          <!-- Name highlight card -->
          <Border Background="{StaticResource SurfaceBrush}"
                  BorderBrush="{StaticResource BorderSubtleBrush}"
                  BorderThickness="1"
                  CornerRadius="12"
                  Padding="28,20"
                  Margin="0,16,0,8"
                  HorizontalAlignment="Center"
                  MinWidth="320">
            <StackPanel HorizontalAlignment="Center">
              <TextBlock Style="{StaticResource DisplayTextStyle}"
                         FontSize="36"
                         Foreground="{StaticResource LimeGreenBrush}">
                <TextBlock.Effect>
                  <DropShadowEffect Color="#A4CC27" BlurRadius="16" ShadowDepth="0" Opacity="0.2" />
                </TextBlock.Effect>
                <Run Text="{Binding TopMatchName, Mode=OneWay}" />
              </TextBlock>
              <TextBlock Text="{Binding TopMatchStudentId}"
                         Style="{StaticResource MonoTextStyle}"
                         HorizontalAlignment="Center"
                         Margin="0,6,0,0" />
            </StackPanel>
          </Border>

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,28,0,0">
            <Button Content="Yes, that's me"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding ConfirmCommand}"
                    Margin="0,0,16,0" />
            <Button Content="Not me"
                    Style="{StaticResource WarningButtonStyle}"
                    Command="{Binding DenyCommand}" />
          </StackPanel>
        </StackPanel>

        <!-- Multiple match selection -->
        <StackPanel Visibility="{Binding IsMultipleMatch, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="Select your name"
                     Style="{StaticResource HeadingTextStyle}"
                     Margin="0,0,0,24" />

          <ListBox ItemsSource="{Binding Matches}"
                   SelectedItem="{Binding SelectedMatch}"
                   Background="Transparent"
                   BorderThickness="0"
                   Margin="0,0,0,24">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <Border x:Name="border"
                              Background="{StaticResource SurfaceBrush}"
                              BorderBrush="{StaticResource BorderSubtleBrush}"
                              BorderThickness="1"
                              CornerRadius="10"
                              Padding="24,16"
                              Margin="0,4"
                              Cursor="Hand"
                              MinWidth="420">
                        <ContentPresenter />
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource LimeGreenBrush}" />
                          <Setter TargetName="border" Property="Background" Value="{StaticResource SurfaceLightBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                          <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource LimeGreenBrush}" />
                          <Setter TargetName="border" Property="Background" Value="#20A4CC27" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <DockPanel>
                  <TextBlock Text="{Binding Student.StudentId}"
                             Style="{StaticResource MonoTextStyle}"
                             DockPanel.Dock="Right"
                             VerticalAlignment="Center" />
                  <TextBlock Style="{StaticResource BodyTextStyle}" FontSize="20" VerticalAlignment="Center">
                    <Run Text="{Binding Student.FirstName}" />
                    <Run Text=" " />
                    <Run Text="{Binding Student.LastName}" FontWeight="SemiBold" />
                  </TextBlock>
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <Button Content="Confirm"
                  Style="{StaticResource PrimaryButtonStyle}"
                  Command="{Binding ConfirmCommand}"
                  HorizontalAlignment="Center" />
        </StackPanel>

        <!-- No match -->
        <StackPanel Visibility="{Binding IsNoMatch, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="No match found"
                     Style="{StaticResource HeadingTextStyle}"
                     Foreground="{StaticResource GoldBrush}"
                     Margin="0,0,0,12" />
          <TextBlock Text="We couldn't match your name to the roster. Please try again."
                     Style="{StaticResource SubheadingTextStyle}"
                     Margin="0,0,0,28" />
          <Button Content="Try Again"
                  Style="{StaticResource WarningButtonStyle}"
                  Command="{Binding DenyCommand}"
                  HorizontalAlignment="Center" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
