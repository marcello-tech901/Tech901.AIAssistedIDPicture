<UserControl x:Class="Tech901.IdPhoto.App.Views.IdleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <!-- Frosted overlay for depth -->
    <Border Background="{StaticResource OverlayBrush}" />

    <!-- Subtle ambient glow behind content -->
    <Ellipse Width="500" Height="500"
             HorizontalAlignment="Center"
             VerticalAlignment="Center"
             Margin="0,-80,0,0"
             IsHitTestVisible="False"
             Opacity="0.08">
      <Ellipse.Fill>
        <RadialGradientBrush>
          <GradientStop Color="#A4CC27" Offset="0" />
          <GradientStop Color="#00A4CC27" Offset="1" />
        </RadialGradientBrush>
      </Ellipse.Fill>
    </Ellipse>

    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
      <StackPanel.RenderTransform>
        <TranslateTransform />
      </StackPanel.RenderTransform>
      <StackPanel.Triggers>
        <EventTrigger RoutedEvent="Loaded">
          <BeginStoryboard>
            <Storyboard>
              <!-- Staggered fade-in entrance -->
              <DoubleAnimation Storyboard.TargetProperty="Opacity"
                               From="0" To="1" Duration="0:0:0.8">
                <DoubleAnimation.EasingFunction>
                  <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
              </DoubleAnimation>
              <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                               From="40" To="0" Duration="0:0:0.9">
                <DoubleAnimation.EasingFunction>
                  <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
              </DoubleAnimation>
            </Storyboard>
          </BeginStoryboard>
        </EventTrigger>
      </StackPanel.Triggers>

      <!-- Logo with soft glow -->
      <Grid HorizontalAlignment="Center" Margin="0,0,0,52">
        <Image Source="/Assets/Branding/Tech901-logo.png"
               Width="340" Height="110"
               Stretch="Uniform"
               RenderOptions.BitmapScalingMode="HighQuality">
          <Image.Effect>
            <DropShadowEffect Color="#A4CC27" BlurRadius="30" ShadowDepth="0" Opacity="0.12" />
          </Image.Effect>
        </Image>
      </Grid>

      <!-- Hero headline -->
      <TextBlock Text="Welcome"
                 Style="{StaticResource HeroTextStyle}"
                 Margin="0,0,0,8" />

      <!-- Accent line -->
      <Border Width="64" Height="3" CornerRadius="2"
              Background="{StaticResource LimeGlowBrush}"
              HorizontalAlignment="Center"
              Margin="0,0,0,28">
        <Border.Effect>
          <DropShadowEffect Color="#A4CC27" BlurRadius="12" ShadowDepth="0" Opacity="0.5" />
        </Border.Effect>
      </Border>

      <!-- Pulsing prompt -->
      <TextBlock Text="{Binding StatusMessage}"
                 Style="{StaticResource SubheadingTextStyle}"
                 FontSize="22">
        <TextBlock.Triggers>
          <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                 From="0" To="1"
                                 Duration="0:0:0.6"
                                 BeginTime="0:0:0.5" />
              </Storyboard>
            </BeginStoryboard>
            <BeginStoryboard>
              <Storyboard RepeatBehavior="Forever" BeginTime="0:0:1.2">
                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                 From="0.35" To="1.0"
                                 Duration="0:0:2.2"
                                 AutoReverse="True">
                  <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                  </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
              </Storyboard>
            </BeginStoryboard>
          </EventTrigger>
        </TextBlock.Triggers>
      </TextBlock>
    </StackPanel>
  </Grid>
</UserControl>
